[Unit]
Description=NECTRA Platform Service (Python FastAPI & Multi-Chain Engine)
After=network.target

[Service]
Type=simple
User=nectra
WorkingDirectory=/var/www/nectra-platform
ExecStart=/usr/bin/python3 -m uvicorn app:app --app-dir py_server --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5s

# Start limits: max 5 restarts in 60 seconds
StartLimitIntervalSec=60s
StartLimitBurst=5

# Environment
Environment=PORT=3000

# Process management
KillMode=mixed
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
